# Адрес сайта приходит переменной HD_SITE.
#
# По умолчанию «:80» — слушать любой адрес по HTTP внутри контейнера, а
# наружу порт выводит compose. Для поддомена с HTTPS сюда вписывается имя,
# и тогда Caddy берёт сертификат сам.
#
# Значение по умолчанию задано в compose, а не здесь: подстановка
# `{$HD_SITE::80}` применила бы default только к незаданной переменной, а
# переданная пустая строка оставила бы адрес пустым — и Caddy принял бы этот
# блок за блок глобальных настроек.
{$HD_SITE} {
	# API — по префиксу /api, всё остальное отдаёт веб-приложение.
	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}
