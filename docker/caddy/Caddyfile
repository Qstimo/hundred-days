# Адрес сайта — «:80» без имени и без TLS, и это не упрощение, а место этого
# прокси в цепочке. Снаружи стек стоит за прокси CAIRN: тот держит 80 и 443,
# получает сертификат на поддомен и приходит сюда по внутренней сети. Два
# сертификата на один порт не живут, поэтому здесь HTTPS не включается.
#
# Свой прокси при этом нужен: в нём живёт разделение «/api» и всего
# остального. Унеси его в Caddyfile CAIRN — и маршруты этого приложения
# оказались бы в чужом репозитории.
:80 {
	# API — по префиксу /api, всё остальное отдаёт веб-приложение.
	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}
