# --- База ---
# Пароль владельца схемы: им применяются миграции.
HD_POSTGRES_PASSWORD=
# Пароль роли приложения: ею идёт обычная работа, без права менять схему.
HD_APP_PASSWORD=
# Порт базы наружу. Нужен только локально, для миграций и тестов с хоста.
HD_POSTGRES_PORT=5436
# Порт API наружу. Нужен только локально, пока нет прокси.
HD_API_PORT=3001

# --- Приложение ---
# Зона, по которой определяется «сегодня». Не браузер: иначе запись в час
# ночи уехала бы на другую дату.
HD_TIMEZONE=Europe/Moscow
# Флаг Secure у cookie сессии. Включать вместе с HTTPS: по HTTP он сделал бы
# вход невозможным.
HD_SECURE_COOKIE=false

# --- Доступ ---
# Порт, на котором стек слушает на машине.
#
# 80 и 443 заняты прокси CAIRN. 8080 на машине разработки тоже оказался
# занят — его держит контейнер другого проекта. Поэтому порт обязательно
# проверяется перед развёртыванием: scripts/preflight.sh отказывается
# продолжать, если он занят посторонним.
HD_HTTP_PORT=8090
# Имя сайта для Caddy. Пусто — слушать любой адрес по HTTP на своём порту
# (compose подставит «:80»). Для поддомена с HTTPS путь идёт через прокси
# CAIRN, и значение остаётся пустым.
HD_SITE=
