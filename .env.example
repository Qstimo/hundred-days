# --- База ---
# Пароль владельца схемы: им применяются миграции.
HD_POSTGRES_PASSWORD=
# Пароль роли приложения: ею идёт обычная работа, без права менять схему.
HD_APP_PASSWORD=
# Порт базы наружу. Нужен только локально, для миграций и тестов с хоста.
HD_POSTGRES_PORT=5436
# Порт API наружу. Нужен только локально, пока нет прокси.
HD_API_PORT=3001

# --- Приложение ---
# Зона, по которой определяется «сегодня». Не браузер: иначе запись в час
# ночи уехала бы на другую дату.
HD_TIMEZONE=Europe/Moscow
# Флаг Secure у cookie сессии. Пара к схеме в HD_PUBLIC_URL: по HTTP такая
# cookie не сохранится и вход не пройдёт, а по HTTPS без неё cookie сессии
# ходила бы и по открытому каналу. Рассогласование ловит scripts/preflight.sh.
HD_SECURE_COOKIE=false

# --- Доступ ---
# Публичный адрес приложения со схемой. Из него развёртывание печатает адрес,
# а preflight сверяет схему с HD_SECURE_COOKIE.
#
# На сервере: https://ПОДДОМЕН — снаружи стек стоит за прокси CAIRN, тот
# держит 80 и 443 и получает сертификат. Домен живёт только здесь: .env в
# .gitignore, а репозиторий публичный.
#
# На машине разработки: http://localhost:8090.
HD_PUBLIC_URL=http://localhost:8090

# Общая docker-сеть, в которой прокси CAIRN находит этот стек по имени
# «hundred-days». Заполнено — скрипты добавляют docker-compose.server.yml и
# подключают прокси к этой сети, а портов стек не публикует вовсе.
#
# На сервере: hundred-days-edge (сеть создаёт стек CAIRN).
# На машине разработки: пусто — такой сети там нет, и вход идёт портом.
HD_EDGE_NETWORK=

# Порт входа на машине разработки (docker-compose.override.yml). На сервере
# не используется: 8080 там держит контейнер другого проекта, а наружу этот
# стек всё равно не публикуется.
HD_HTTP_PORT=8090
