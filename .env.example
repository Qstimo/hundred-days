# --- База ---
# Пароль владельца схемы: им применяются миграции.
HD_POSTGRES_PASSWORD=
# Пароль роли приложения: ею идёт обычная работа, без права менять схему.
HD_APP_PASSWORD=
# Порт базы наружу. Нужен только локально, для миграций и тестов с хоста.
HD_POSTGRES_PORT=5436
# Порт API наружу. Нужен только локально, пока нет прокси.
HD_API_PORT=3001

# --- Приложение ---
# Зона, по которой определяется «сегодня». Не браузер: иначе запись в час
# ночи уехала бы на другую дату.
HD_TIMEZONE=Europe/Moscow
# Флаг Secure у cookie сессии. Включать вместе с HD_SITE: по HTTP такая
# cookie не сохранится и вход не пройдёт, а по HTTPS без неё cookie сессии
# ходила бы и по открытому каналу. Рассогласование ловит scripts/preflight.sh.
HD_SECURE_COOKIE=false

# --- Доступ ---
# Имя сайта для Caddy — главный переключатель между двумя режимами.
#
# Пусто: слушать любой адрес по HTTP на порту HD_HTTP_PORT (compose подставит
# «:80» внутри контейнера). Так удобно на машине разработки, где домена нет.
#
# Имя поддомена, например hundred-days.example.com: Caddy сам получает
# сертификат Let's Encrypt и переводит весь трафик на HTTPS. Тогда нужны
# запись A на этот поддомен и порты 80 и 443, доступные из интернета.
HD_SITE=
# Порты стека на машине.
#
# Для HD_SITE это обязательно 80 и 443: Let's Encrypt стучится на 80, а
# браузер идёт на 443, и сдвинутые порты сертификат не выпустят. Без HD_SITE
# порты произвольные — 80 и 443 на машине разработки могут быть заняты, а
# 8080 на этой машине держит контейнер другого проекта.
#
# Занятый порт — единственное, чем этот стек может столкнуться с соседями,
# поэтому scripts/preflight.sh проверяет оба порта перед развёртыванием.
HD_HTTP_PORT=8090
HD_HTTPS_PORT=8443
